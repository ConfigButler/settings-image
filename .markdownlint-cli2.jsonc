// markdownlint-cli2 configuration -- https://github.com/DavidAnson/markdownlint-cli2
// `task lint-markdown` runs it over every git-tracked .md file. Same rules as gitops-reverser.
{
  "config": {
    // Wrap at 100 is the convention; 120 is the gate. Code and tables cannot be rewrapped.
    "MD013": {
      "line_length": 120,
      "code_blocks": false,
      "tables": false,
      "headings": true
    },
    "MD024": { "siblings_only": true },
    "MD004": { "style": "dash" },
    "MD040": {
      "allowed_languages": ["bash", "yaml", "text", "go", "console", "json", "jsonc", "dockerfile", "csharp", "mermaid"]
    },
    "MD029": { "style": "ordered" },
    // Writes |---|---| tables without padded cells.
    "MD060": false
  },
  // CHANGELOG.md is generated by release-please. CLAUDE.md is one `@AGENTS.md` import line for
  // Claude Code, not a document.
  "ignores": ["CHANGELOG.md", "CLAUDE.md", "node_modules/**"]
}
